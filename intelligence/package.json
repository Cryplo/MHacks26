{
  "name": "@behavior-engine/intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intelligence lane: population, Jev worker, cache, ratings, text jobs, paired experiments and reports.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-contract.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "node scripts/check-contract.mjs && vitest run tests/contract",
    "test:providers": "vitest run tests/providers",
    "test:experiments": "vitest run tests/experiments",
    "test:coverage": "vitest run --coverage",
    "dev:worker": "tsx src/cli/worker.ts",
    "population:fixture": "tsx src/cli/population.ts",
    "smoke:jev": "tsx src/cli/jev-smoke.ts",
    "plausibility": "tsx src/cli/plausibility.ts",
    "experiment:mock": "tsx src/cli/experiment.ts",
    "dev:integration": "node scripts/integration.mjs",
    "test:integration:engine": "node scripts/integration.mjs test"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
