# Runtime port: fixture | spacetime (no implicit fallback between them)
BEHAVIOR_RUNTIME_MODE=fixture
# Path to Engine's built Node adapter (spacetime mode only)
BEHAVIOR_RUNTIME_ADAPTER=../engine/client/dist/node.js
BEHAVIOR_RUNTIME_URI=ws://127.0.0.1:3000
BEHAVIOR_RUNTIME_DATABASE=behavior-engine
# Process role: worker (decision/rating/text/population jobs) | coordinator (experiment jobs only)
BEHAVIOR_ROLE=worker
# Separate identities: ordinary worker vs experiment coordinator (operator only for experiment:mock / Engine tests)
BEHAVIOR_WORKER_TOKEN=
BEHAVIOR_COORDINATOR_TOKEN=
BEHAVIOR_OPERATOR_TOKEN=

# Provider: mock | jev (mock is labeled Mock everywhere)
BEHAVIOR_PROVIDER=mock
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.13.0
JEV_HTTP_TIMEOUT_MS=10000
JEV_MAX_RESPONSE_BYTES=262144

# Operational limits (account-wide; more workers do not raise them)
JEV_REQUESTS_PER_SECOND=2
JEV_INPUT_TOKENS_PER_MINUTE=60000
JEV_MAX_CONCURRENCY=4
# Optional hard stop on provider calls per executor class for this process (unset = no cap)
BEHAVIOR_MAX_PROVIDER_CALLS=
WORKER_LEASE_MS=30000
WORKER_QUEUE_LIMIT=256
BEHAVIOR_STATUS_EVERY_MS=30000

# Local durable state (cache, processing journal, usage ledger); one subdirectory per role
INTELLIGENCE_DATA_DIR=.data

# Local Laya (Apple Silicon; see local/README.md). Set BEHAVIOR_PROVIDER=laya.
LAYA_ENDPOINT=http://127.0.0.1:4318
LAYA_BATCH_SIZE=8
