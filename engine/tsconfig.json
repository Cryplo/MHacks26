{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "resolveJsonModule": true, "esModuleInterop": true,
    "outDir": "dist", "declaration": true, "sourceMap": true,
    "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["src", "contract", "client", "tools", "tests", "vitest.config.ts"],
  "exclude": ["client/generated", "client/dist", "dist", "node_modules"]
}
