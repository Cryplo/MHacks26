# Public, non-secret build profile. The adapter is A's bundled browser module copied by
# integration tooling into public/runtime/. Never put tokens or API keys here.
VITE_RUNTIME_PROFILE=live
VITE_RUNTIME_ADAPTER_URL=/runtime/browser.js
VITE_RUNTIME_URI=ws://127.0.0.1:3000
VITE_RUNTIME_DATABASE=behavior-engine
