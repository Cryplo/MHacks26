{
  "name": "@behavior-engine/experience",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Behavior Engine operator product (Experience lane): React/Vite/PixiJS UI, Harbor Lights content, fixture runtime and browser tests.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode fixture",
    "dev:live": "node scripts/check-live-adapter.mjs && vite --mode live",
    "build": "npm run build:fixture",
    "build:fixture": "vite build --mode fixture --outDir dist/fixture",
    "build:live": "node scripts/check-live-adapter.mjs && vite build --mode live --outDir dist/live",
    "preview:fixture": "vite preview --mode fixture --outDir dist/fixture --port 4317 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:contract && npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:e2e:fixture": "playwright test --config playwright.fixture.config.ts",
    "test:e2e:live": "node scripts/e2e-live.mjs",
    "content:paint": "tsx content/harbor-lights/tools/paint.ts",
    "content:validate": "tsx content/harbor-lights/tools/validate.ts",
    "content:compile": "node scripts/compile-content.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:perf": "PERF=1 playwright test --config playwright.fixture.config.ts --grep @perf --workers=1 --project desktop",
    "dev:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
