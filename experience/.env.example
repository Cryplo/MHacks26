# Copy to .env.local to override a profile locally. Only VITE_RUNTIME_* keys are exposed to
# the browser bundle, and none of them may contain a credential: the session token comes from
# the server session at runtime (RuntimeConfig.onToken), never from build-time variables.
VITE_RUNTIME_PROFILE=live
VITE_RUNTIME_ADAPTER_URL=/runtime/browser.js
VITE_RUNTIME_URI=http://127.0.0.1:3000
VITE_RUNTIME_DATABASE=mhacks-engine
